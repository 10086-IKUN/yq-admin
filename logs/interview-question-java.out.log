2026-07-18 20:35:09.472 [http-nio-8080-exec-3] INFO  cn.yanque.common.aop.ControllerLogAspect [guid=e2238dea0132439db3cb207e74faa9f4] - 接口结束: uri=/yq-admin/api/exams/questions, controller=ExamAdminController#questionPage, cost=34ms, result={"code":200,"message":"success","data":{"total":7,"pageNum":1,"pageSize":1000,"records":[{"id":7,"questionType":"SHORT","questionStem":"在AI Agent系统中，如何设计兼顾短期交互连贯性与长期记忆演化的上下文管理机制？","correctAnswer":"上下文管理需分层设计：状态层使用LangGraph的StateGraph实现有向无环图编排，每个节点封装确定性逻辑（如意图识别、工具调用），状态对象持久化存储关键上下文（如用户ID、对话ID、当前任务栈）；记忆层分为短期记忆（滑动窗口保留最近N轮对话，防止上下文爆炸）和长期记忆（对历史对话做摘要压缩，存入向量库并关联用户画像标签）；同时引入结构化插槽（slot-filling）管理用户偏好与实体约束（如‘租户ID=XYZ’‘语言=en’），确保跨轮次信息一致性。所有记忆操作需通过统一MemoryManager接口，支持审计日志与GxP合规追溯。","answerAnalysis":"状态用LangGraph StateGraph编排+持久化；记忆分短期（滑动窗口）和长期（摘要压缩+向量存储）；用户偏好用结构化插槽管理；统一MemoryManager接口保障可审计。","difficulty":"MEDIUM","status":1,"createdBy":1,"createdAt":"2026-07-18T20:22:24","updatedAt":"2026-07-18T20:22:24"},{"id":6,"questionType":"SHORT","questionStem":"请简述面向对象的三大特征。","correctAnswer":"封装、继承、多态","answerAnalysis":"面向对象三大特征是封装、继承、多态，需要结合含义说明。","difficulty":"MEDIUM","status":1,"createdBy":1,"createdAt":"2026-06-26T09:15:16","updatedAt":"2026-06-26T09:15:16"},{"id":5,"questionType":"FILL","questionStem":"Java 程序的入口方法名称是 ______。","correctAnswer":"main","answerAnalysis":"main 方法是 Java 程序运行的入口。","difficulty":"EASY","status":1,"createdBy":1,"createdAt":"2026-06-26T09:15:16","updatedAt":"2026-06-26T09:15:16"},{"id":4,"questionType":"JUDGE","questionStem":"Java 中一个类只能继承一个父类。","correctAnswer":"TRUE","answerAnalysis":"Java 是单继承语言，一个类只能直接继承一个父类。","difficulty":"EASY","status":1,"createdBy":1,"createdAt":"2026-06-26T09:15:16","updatedAt":"2026-06-26T09:15:16"},{"id":3,"questionType":"MULTIPLE","questionStem":"下面哪些属于 Java 基本数据类型？","optionsJson":"[\"int\", \"String\", \"boolean\", \"double\"]","correctAnswer":"A,C,D","answerAnalysis":"String 是引用类型，不是基本数据类型。","difficulty":"MEDIUM","status":1,"createdBy":1,"createdAt":"2026-06-26T09:15:16","updatedAt":"2026-06-26T09:15:16"},{"id":2,"questionType":"SINGLE","questionStem":"下面哪个集合允许元素重复？","optionsJson":"[\"HashSet\", \"TreeSet\", \"ArrayList\", \"LinkedHashSet\"]","correctAnswer":"C","answerAnalysis":"List 类型集合允许元素重复，ArrayList 是 List 的常用实现类。","difficulty":"EASY","status":1,"createdBy":1,"createdAt":"2026-06-26T09:15:16","updatedAt":"2026-06-26T09:15:16"},{"id":1,"questionType":"SINGLE","questionStem":"Java 中用于定义类的关键字是？","optionsJson":"[\"class\", \"interface\", \"public\", \"static\"]","correctAnswer":"A","answerAnalysis":"Java 使用 class 关键字定义普通类。","difficulty":"EASY","status":1,"createdBy":1,"createdAt":"2026-06-26T09:15:16","updatedAt":"2026-06-26T09:15:16"}]}}
