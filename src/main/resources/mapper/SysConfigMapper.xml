<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.yanque.models.system.config.mapper.SysConfigMapper">

    <resultMap id="SysConfigMap" type="cn.yanque.models.system.config.pojo.entity.SysConfigEntity">
        <id property="id" column="id"/>
        <result property="k" column="k"/>
        <result property="v" column="v"/>
    </resultMap>

    <sql id="BaseColumns">
        id, `k`, `v`
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into sys_config (`k`, `v`)
        values (#{k}, #{v})
    </insert>

    <update id="updateById">
        update sys_config
        <set>
            <if test="k != null">`k` = #{k},</if>
            <if test="v != null">`v` = #{v},</if>
        </set>
        where id = #{id}
    </update>

    <select id="selectById" resultMap="SysConfigMap">
        select <include refid="BaseColumns"/>
        from sys_config
        where id = #{id}
    </select>

    <select id="selectByKey" resultMap="SysConfigMap">
        select <include refid="BaseColumns"/>
        from sys_config
        where `k` = #{k}
    </select>

    <select id="selectAll" resultMap="SysConfigMap">
        select <include refid="BaseColumns"/>
        from sys_config
    </select>

    <delete id="deleteById">
        delete from sys_config where id = #{id}
    </delete>

</mapper>
