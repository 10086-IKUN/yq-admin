<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.yanque.models.edu.campus.mapper.EduCampusMapper">

    <resultMap id="EduCampusMap" type="cn.yanque.models.edu.campus.pojo.entity.EduCampusEntity">
        <id property="id" column="id"/>
        <result property="campusName" column="campus_name"/>
        <result property="principalUserId" column="principal_user_id"/>
        <result property="address" column="address"/>
        <result property="contactPhone" column="contact_phone"/>
        <result property="remark" column="remark"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="BaseColumns">
        id, campus_name, principal_user_id, address, contact_phone, remark, status, created_at, updated_at
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into edu_campus (campus_name, principal_user_id, address, contact_phone, remark, status)
        values (#{campusName}, #{principalUserId}, #{address}, #{contactPhone}, #{remark}, #{status})
    </insert>

    <update id="updateById">
        update edu_campus
        <set>
            <if test="campusName != null">campus_name = #{campusName},</if>
            <if test="principalUserId != null">principal_user_id = #{principalUserId},</if>
            <if test="address != null">address = #{address},</if>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        where id = #{id}
    </update>

    <select id="selectById" resultMap="EduCampusMap">
        select <include refid="BaseColumns"/>
        from edu_campus
        where id = #{id}
    </select>

    <select id="selectPage" resultMap="EduCampusMap">
        select <include refid="BaseColumns"/>
        from edu_campus
        <where>
            <if test="keyword != null and keyword != ''">
                and campus_name like concat('%', #{keyword}, '%')
            </if>
            <if test="status != null">
                and status = #{status}
            </if>
        </where>
        order by id desc
    </select>

    <delete id="deleteById">
        delete from edu_campus where id = #{id}
    </delete>

    <!--
        批量查询校区
        作用：一次查询多个校区，避免N+1查询问题
        动态SQL：foreach遍历ID集合，生成 IN (id1, id2, ...) 语句
    -->
    <select id="selectByIds" resultMap="EduCampusMap">
        select <include refid="BaseColumns"/>
        from edu_campus
        where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
