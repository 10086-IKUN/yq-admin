<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.yanque.models.duty.mapper.EduDutyAssignmentMapper">

    <resultMap id="DutyAssignmentMap" type="cn.yanque.common.pojo.entity.EduDutyAssignmentEntity">
        <id property="id" column="id"/>
        <result property="dutyDate" column="duty_date"/>
        <result property="dutyType" column="duty_type"/>
        <result property="classId" column="class_id"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="teacherId" column="teacher_id"/>
        <result property="remark" column="remark"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="BaseColumns">
        id, duty_date, duty_type, class_id, start_time, end_time, teacher_id, remark, created_at, updated_at
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into edu_duty_assignment (duty_date, duty_type, class_id, start_time, end_time, teacher_id, remark)
        values (#{dutyDate}, #{dutyType}, #{classId}, #{startTime}, #{endTime}, #{teacherId}, #{remark})
    </insert>

    <update id="updateById">
        update edu_duty_assignment
        <set>
            <if test="dutyDate != null">duty_date = #{dutyDate},</if>
            <if test="dutyType != null">duty_type = #{dutyType},</if>
            <if test="classId != null">class_id = #{classId},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="teacherId != null">teacher_id = #{teacherId},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where id = #{id}
    </update>

    <select id="selectById" resultMap="DutyAssignmentMap">
        select <include refid="BaseColumns"/>
        from edu_duty_assignment
        where id = #{id}
    </select>

    <select id="selectPage" resultMap="DutyAssignmentMap">
        select <include refid="BaseColumns"/>
        from edu_duty_assignment
        <where>
            <if test="classId != null">
                and class_id = #{classId}
            </if>
            <if test="dutyType != null and dutyType != ''">
                and duty_type = #{dutyType}
            </if>
            <if test="startDate != null">
                and duty_date &gt;= #{startDate}
            </if>
            <if test="endDate != null">
                and duty_date &lt;= #{endDate}
            </if>
        </where>
        order by duty_date desc, start_time asc
    </select>

    <delete id="deleteById">
        delete from edu_duty_assignment where id = #{id}
    </delete>

    <select id="countByDateAndTypeAndClass" resultType="int">
        select count(*) from edu_duty_assignment
        where duty_date = #{dutyDate}
          and duty_type = #{dutyType}
          and class_id = #{classId}
          <if test="excludeId != null">
              and id != #{excludeId}
          </if>
    </select>

</mapper>
