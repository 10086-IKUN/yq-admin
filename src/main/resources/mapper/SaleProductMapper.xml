<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.yanque.models.sale.mapper.SaleProductMapper">

    <resultMap id="SaleProductMap" type="cn.yanque.models.sale.entity.SaleProductEntity">
        <id property="id" column="id"/>
        <result property="productCode" column="product_code"/>
        <result property="productName" column="product_name"/>
        <result property="studyMode" column="study_mode"/>
        <result property="productPrice" column="product_price"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sale_product (product_code, product_name, study_mode, product_price)
        VALUES (#{productCode}, #{productName}, #{studyMode}, #{productPrice})
    </insert>

    <update id="updateById">
        UPDATE sale_product
        SET product_name = #{productName},
            study_mode = #{studyMode},
            product_price = #{productPrice},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <select id="selectById" resultMap="SaleProductMap">
        SELECT * FROM sale_product WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="SaleProductMap">
        SELECT * FROM sale_product ORDER BY id DESC
    </select>

    <select id="selectPage" resultMap="SaleProductMap">
        SELECT * FROM sale_product
        <where>
            <if test="keyword != null and keyword != ''">
                AND (product_name LIKE CONCAT('%', #{keyword}, '%')
                     OR product_code LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY id DESC
    </select>

</mapper>
