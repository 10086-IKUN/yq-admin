<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.yanque.models.edu.mapper.EduCourseMapper">

    <resultMap id="EduCourseMap" type="cn.yanque.common.pojo.entity.EduCourseEntity">
        <id property="id" column="id"/>
        <result property="courseName" column="course_name"/>
        <result property="courseDays" column="course_days"/>
        <result property="feishuMaterialPath" column="feishu_material_path"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="BaseColumns">
        id, course_name, course_days, feishu_material_path, status, created_at, updated_at
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into edu_course (course_name, course_days, feishu_material_path, status)
        values (#{courseName}, #{courseDays}, #{feishuMaterialPath}, #{status})
    </insert>

    <update id="updateById">
        update edu_course
        <set>
            <if test="courseName != null">course_name = #{courseName},</if>
            <if test="courseDays != null">course_days = #{courseDays},</if>
            <if test="feishuMaterialPath != null">feishu_material_path = #{feishuMaterialPath},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        where id = #{id}
    </update>

    <select id="selectById" resultMap="EduCourseMap">
        select <include refid="BaseColumns"/>
        from edu_course
        where id = #{id}
    </select>

    <select id="selectPage" resultMap="EduCourseMap">
        select <include refid="BaseColumns"/>
        from edu_course
        <where>
            <if test="keyword != null and keyword != ''">
                and course_name like concat('%', #{keyword}, '%')
            </if>
            <if test="status != null">
                and status = #{status}
            </if>
        </where>
        order by id desc
    </select>

    <delete id="deleteById">
        delete from edu_course where id = #{id}
    </delete>

    <!--
        批量查询课程
        作用：一次查询多个课程，避免N+1查询问题
    -->
    <select id="selectByIds" resultMap="EduCourseMap">
        select <include refid="BaseColumns"/>
        from edu_course
        where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
