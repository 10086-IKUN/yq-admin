YANQUE_AI_BASE_URL=http://localhost:8000

# Java 与 Python 必须配置相同的内部调用令牌。
YQ_AI_PROMPT_INTERNAL_TOKEN=replace-with-a-long-random-token

# 火山引擎日志服务配置；不要把真实 AK/SK 提交到 Git。
VOLCENGINE_TLS_ENDPOINT=
VOLCENGINE_TLS_REGION=cn-beijing
VOLCENGINE_TLS_ACCESS_KEY_ID=
VOLCENGINE_TLS_ACCESS_KEY_SECRET=
VOLCENGINE_TLS_CONNECT_TIMEOUT_MS=5000
VOLCENGINE_TLS_READ_TIMEOUT_MS=10000
